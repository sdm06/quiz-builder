# --- Runtime ---------------------------------------------------------------
# Port the NestJS API listens on (the frontend dev server runs on 3000).
PORT=4000

# Origins allowed through CORS.
CORS_ORIGIN=http://localhost:3000

# --- Database --------------------------------------------------------------
# Prisma 7 reads this from prisma.config.ts. The path is resolved relative to
# the directory the process is started from (run commands from `backend/`).
# SQLite requires enums and cascades, both supported since Prisma 6.2.
DATABASE_URL="file:./prisma/dev.db"
{
  "name": "quiz-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Quiz Builder: NestJS + Prisma API and a Next.js App Router frontend",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @quiz-builder/backend build && pnpm --filter @quiz-builder/frontend build",
    "dev": "pnpm --parallel --filter @quiz-builder/backend --filter @quiz-builder/frontend dev",
    "dev:backend": "pnpm --filter @quiz-builder/backend dev",
    "dev:frontend": "pnpm --filter @quiz-builder/frontend dev",
    "lint": "pnpm --filter @quiz-builder/backend lint && pnpm --filter @quiz-builder/frontend lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @quiz-builder/backend typecheck && pnpm --filter @quiz-builder/frontend typecheck",
    "test": "pnpm --filter @quiz-builder/backend test && pnpm --filter @quiz-builder/frontend test",
    "db:generate": "pnpm --filter @quiz-builder/backend db:generate",
    "db:migrate": "pnpm --filter @quiz-builder/backend db:migrate",
    "db:deploy": "pnpm --filter @quiz-builder/backend db:deploy",
    "db:seed": "pnpm --filter @quiz-builder/backend db:seed",
    "db:reset": "pnpm --filter @quiz-builder/backend db:reset",
    "db:studio": "pnpm --filter @quiz-builder/backend db:studio",
    "bootstrap": "pnpm install && pnpm db:generate && pnpm db:deploy && pnpm db:seed"
  }
}